-- Твоя функция getTorso
local function getTorso(x)
	x = x or Players.LocalPlayer.Character
	return x:FindFirstChild("Torso") or x:FindFirstChild("UpperTorso") or x:FindFirstChild("LowerTorso") or x:FindFirstChild("HumanoidRootPart")
end

-- Функция остановки с возвратом на исходную точку
local function stopHumble()
	activeHumbleRunning = false

	if humbleDied then humbleDied:Disconnect() humbleDied = nil end
	if targetDied then targetDied:Disconnect() targetDied = nil end
	if humbleLoop then humbleLoop:Disconnect() humbleLoop = nil end

	pcall(function()
		local char = player.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.Sit = false
			end
			local root = char:FindFirstChild("HumanoidRootPart")
			if root and originalCFrame then
				root.CFrame = originalCFrame
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end)
	originalCFrame = nil
end

-- Основная функция HumbleTarget
local function HumbleTarget(targetPlayer)
	if activeHumbleRunning then
		stopHumble()
		Fluent:Notify({
			Title = "TrollGe",
			Content = "Humble stopped.",
			SubContent = "Success!",
			Duration = 3
		})
		return
	end

	if not targetPlayer or not targetPlayer.Character then 
		Fluent:Notify({
			Title = "TrollGe",
			Content = "Humble target not found!",
			SubContent = "Failed.",
			Duration = 3
		})
		return 
	end

	local speakerChar = player.Character
	local humanoid = speakerChar and speakerChar:FindFirstChildWhichIsA("Humanoid")
	local speakerRoot = speakerChar and speakerChar:FindFirstChild("HumanoidRootPart")

	if not (speakerChar and humanoid and speakerRoot) then return end

	originalCFrame = speakerRoot.CFrame
	activeHumbleRunning = true

	Fluent:Notify({
		Title = "TrollGe",
		Content = "Started humbling: " .. targetPlayer.Name,
		SubContent = "Idk.",
		Duration = 3
	})

	humanoid.Sit = true

	humbleDied = humanoid.Died:Connect(function()
		stopHumble()
		Fluent:Notify({
			Title = "TrollGe",
			Content = "You died. Humble stopped.",
			SubContent = "Error.",
			Duration = 3
		})
	end)

	local targetHumanoid = targetPlayer.Character:FindFirstChildWhichIsA("Humanoid")
	if targetHumanoid then
		targetDied = targetHumanoid.Died:Connect(function()
			stopHumble()
			Fluent:Notify({
				Title = "TrollGe",
				Content = "Humble target died. Stopping...",
				SubContent = "Ended.",
				Duration = 3
			})
		end)
	end

	humbleLoop = RunService.Stepped:Connect(function()
		pcall(function()
			local targetChar = targetPlayer.Character
			local myChar = player.Character

			if not targetChar or not myChar then
				stopHumble()
				Fluent:Notify({
					Title = "TrollGe",
					Content = "Humble target quit. Stopping...",
					SubContent = "Ended.",
					Duration = 3
				})
				return
			end

			local otherRoot = getTorso(targetChar)
			local myRoot = myChar:FindFirstChild("HumanoidRootPart")

			if otherRoot and myRoot then
				local waveZ = -1.2 + math.sin(tick() * 15) * 1.0
				local humbleOffset = CFrame.new(0, -1, waveZ - 0.5) * CFrame.Angles(-math.rad(90), 0, 0)

				myRoot.CFrame = otherRoot.CFrame * humbleOffset
				-- Убираем накопление скорости от падения, чтобы не улетать и не получать кик
				myRoot.AssemblyLinearVelocity = Vector3.zero
				myRoot.AssemblyAngularVelocity = Vector3.zero

				humanoid.Sit = true
			end
		end)
	end)
end

local localPlayer = Players.LocalPlayer
local connections = {}

local antifling = false

local function setupCharacterCollision(character)
	local function disableCollide(part)
		if antifling and part:IsA("BasePart") then
			part.CanCollide = false
		end
	end

	for _, part in ipairs(character:GetChildren()) do
		disableCollide(part)
	end

	local childAddedConn = character.ChildAdded:Connect(disableCollide)

	local steppedConn = RunService.Stepped:Connect(function()
		if antifling and character:IsDescendantOf(workspace) then
			for _, part in ipairs(character:GetChildren()) do
				if part:IsA("BasePart") and part.CanCollide then
					part.CanCollide = false
				end
			end
		end
	end)

	character.Destroying:Connect(function()
		childAddedConn:Disconnect()
		steppedConn:Disconnect()
	end)
end

local function trackPlayer(player)
	if player == localPlayer then return end
	local charAddedConn = player.CharacterAdded:Connect(setupCharacterCollision)
	if player.Character then
		setupCharacterCollision(player.Character)
	end
	connections[player] = charAddedConn
end

local function untrackPlayer(player)
	if connections[player] then
		connections[player]:Disconnect()
		connections[player] = nil
	end
end

for _, player in ipairs(Players:GetPlayers()) do
	trackPlayer(player)
end

Players.PlayerAdded:Connect(trackPlayer)
Players.PlayerRemoving:Connect(untrackPlayer)

