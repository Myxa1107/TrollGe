local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

-- Состояние работы функции
local activeSlamRunning = false

-- Универсальный поиск корневого сустава специально для R15 (Root) и R6 (RootJoint)
local function getRootJoint(character)
	if not character then return nil end
	local myRoot = character:FindFirstChild("HumanoidRootPart")
	if myRoot then
		local joint = myRoot:FindFirstChild("Root") or myRoot:FindFirstChild("RootJoint")
		if joint and joint:IsA("Motor6D") then
			return joint
		end
	end

	for _, desc in ipairs(character:GetDescendants()) do
		if desc:IsA("Motor6D") and (desc.Name == "Root" or desc.Name == "RootJoint") then
			return desc
		end
	end
	return nil
end

-- Универсальный поиск основного торса (LowerTorso для R15, Torso для R6)
local function getMainTorso(character)
	if not character then return nil end
	return character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
end

-- ФУНКЦИЯ ПОИСКА БЛИЖАЙШЕГО ИГРОКА
local function getClosestPlayer()
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	local closestPlayer = nil
	local shortestDistance = math.huge

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player and otherPlayer.Character then
			local otherRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
			local otherHumanoid = otherPlayer.Character:FindFirstChildOfClass("Humanoid")

			if otherRoot and otherHumanoid and otherHumanoid.Health > 0 then
				local distance = (otherRoot.Position - myRoot.Position).Magnitude
				if distance < shortestDistance then
					shortestDistance = distance
					closestPlayer = otherPlayer
				end
			end
		end
	end

	return closestPlayer
end

-- ФУНКЦИЯ ВБИВА С ПОДДЕРЖКОЙ R15 / R6
local function executeSlamOnTarget(targetPlayer)
	if activeSlamRunning then
		activeSlamRunning = false
		Fluent:Notify({
			Title = "TrollGe",
			Content = "Suspended by user. Stopping...",
			SubContent = "Failed.", -- Дополнительный мелкий текст (опционально)
			Duration = 3 -- Время отображения в секундах
		})
		return
	end

	-- Если цель не передана явно, ищем ближайшего игрока автоматически
	if not targetPlayer then
		targetPlayer = getClosestPlayer()
	end

	if not targetPlayer or not targetPlayer.Character then
		Fluent:Notify({
			Title = "TrollGe",
			Content = "Target not found!",
			SubContent = "Failed.", -- Дополнительный мелкий текст (опционально)
			Duration = 3 -- Время отображения в секундах
		})
		return
	end

	activeSlamRunning = true

	task.spawn(function()
		local lockedTarget = targetPlayer
		Fluent:Notify({
			Title = "TrollGe",
			Content = "Started killing: ".. lockedTarget.Name,
			SubContent = "Please wait...", -- Дополнительный мелкий текст (опционально)
			Duration = 3 -- Время отображения в секундах
		})

		while activeSlamRunning do
			if not lockedTarget or not lockedTarget.Character then 
				Fluent:Notify({
					Title = "TrollGe",
					Content = "Target quit. Stopping...",
					SubContent = "Success!", -- Дополнительный мелкий текст (опционально)
					Duration = 3 -- Время отображения в секундах
				})
				break 
			end

			local targetChar = lockedTarget.Character
			local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
			local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")

			if not (targetRoot and targetHumanoid) or targetHumanoid.Health <= 0 then 
				Fluent:Notify({
					Title = "TrollGe",
					Content = "Target died. Stopping...",
					SubContent = "Success!", -- Дополнительный мелкий текст (опционально)
					Duration = 3 -- Время отображения в секундах
				})
				break 
			end

			local myChar = player.Character
			local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
			local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
			local head = myChar and myChar:FindFirstChild("Head")
			local myTorso = getMainTorso(myChar)

			if not (myChar and myRoot and myHumanoid and myTorso) then 
				RunService.Heartbeat:Wait()
				continue 
			end

			-- Камера остается на голове для плавности
			if head then
				camera.CameraSubject = head
			end

			-- Расчет позиции с предиктом + ровно 1 студ вверх от торса цели (offset)
			local myPing = 0.05
			pcall(function() myPing = player:GetNetworkPing() end)

			local totalPredictionTime = (myPing * 4.5) + 0.035
			local targetVel = targetRoot.AssemblyLinearVelocity

			local clampedTargetVel = targetVel
			if clampedTargetVel.Magnitude > 100 then
				clampedTargetVel = clampedTargetVel.Unit * 100
			end

			local predictedPos = targetRoot.Position + (clampedTargetVel * totalPredictionTime)
			local slamPos = predictedPos + Vector3.new(0, 1, 0)

			local rootJoint = getRootJoint(myChar)

			-- Фиксируем текущую скорость ходьбы или берем вектор движения от Humanoid
			local moveDir = myHumanoid.MoveDirection
			local walkSpeed = myHumanoid.WalkSpeed
			local targetWalkVel = moveDir * walkSpeed
			local currentVel = Vector3.new(targetWalkVel.X, myRoot.AssemblyLinearVelocity.Y, targetWalkVel.Z)

			local _, currentYRot, _ = myRoot.CFrame:ToEulerAnglesYXZ()

			-- ЧТОБЫ ХОДЬБА В R15 НЕ ЛОМАЛАСЬ:
			-- Запоминаем точное динамическое смещение между торсом и RootPart перед отрывом
			local relativeOffset = CFrame.new()
			if myTorso then
				relativeOffset = myTorso.CFrame:ToObjectSpace(myRoot.CFrame)
			end

			-- 1. Отключаем сустав (в R15 отключит Root, в R6 — RootJoint)
			if rootJoint then
				rootJoint.Enabled = false
			end

			-- 2. Отправляем RootPart в точку сверху цели и гарантируем строго отрицательную скорость по Y (вниз)
			myRoot.CFrame = CFrame.new(slamPos) * CFrame.Angles(0, currentYRot, 0)
			myRoot.AssemblyLinearVelocity = Vector3.new(currentVel.X, -50000, currentVel.Z)
			myRoot.AssemblyAngularVelocity = Vector3.zero

			RunService.RenderStepped:Wait()

			-- 3. Возвращаем RootPart к торсу с учетом сохраненного смещения, чтобы физика R15 не забивала тебя в пол
			if myTorso and myTorso.Parent then
				myRoot.CFrame = myTorso.CFrame * relativeOffset
			end

			myRoot.AssemblyLinearVelocity = currentVel
			myRoot.AssemblyAngularVelocity = Vector3.zero

			-- 4. Включаем сустав обратно
			if rootJoint and rootJoint.Parent then
				rootJoint.Enabled = true
			end

			RunService.Heartbeat:Wait()
		end

		activeSlamRunning = false

		-- ВОССТАНОВЛЕНИЕ
		local finalChar = player.Character
		if finalChar then
			local finalHumanoid = finalChar:FindFirstChildOfClass("Humanoid")
			local rootJoint = getRootJoint(finalChar)

			if finalHumanoid then
				camera.CameraSubject = finalHumanoid
			end

			if rootJoint then
				rootJoint.Enabled = true
			end
		end
	end)
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

-- Состояние и переменные
local activeBangRunning = false
local bangLoop, bangDied, targetDied, bangAnim, bangAnimInstance

-- Вспомогательная функция проверки R6/R15
local function r15(plr)
	local char = plr and plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	return hum and hum.RigType == Enum.HumanoidRigType.R15
end

-- Твоя функция getTorso
local function getTorso(x)
	x = x or Players.LocalPlayer.Character
	return x:FindFirstChild("Torso") or x:FindFirstChild("UpperTorso") or x:FindFirstChild("LowerTorso") or x:FindFirstChild("HumanoidRootPart")
end

-- Простая функция остановки без передачи аргументов
local function stopBang()
	activeBangRunning = false

	if bangDied then bangDied:Disconnect() bangDied = nil end
	if targetDied then targetDied:Disconnect() targetDied = nil end
	if bangLoop then bangLoop:Disconnect() bangLoop = nil end

	pcall(function()
		if bangAnim then bangAnim:Stop() bangAnim = nil end
		if bangAnimInstance then bangAnimInstance:Destroy() bangAnimInstance = nil end
	end)
end

-- Основная функция Bang (работает как тогл: повторный вызов выключает)
local function bangtarget(targetPlayer)
	if activeBangRunning then
		stopBang()
		Fluent:Notify({
			Title = "TrollGe",
			Content = "Bang stopped.",
			SubContent = "Success!",
			Duration = 3
		})
		return
	end

	if not targetPlayer or not targetPlayer.Character then 
		Fluent:Notify({
			Title = "TrollGe",
			Content = "Bang target not found!",
			SubContent = "Failed.",
			Duration = 3
		})
		return 
	end

	local speakerChar = player.Character
	local humanoid = speakerChar and speakerChar:FindFirstChildWhichIsA("Humanoid")
	local speakerRoot = speakerChar and speakerChar:FindFirstChild("HumanoidRootPart")

	if not (speakerChar and humanoid and speakerRoot) then return end

	activeBangRunning = true

	Fluent:Notify({
		Title = "TrollGe",
		Content = "Started banging: " .. targetPlayer.Name,
		SubContent = "Idk.",
		Duration = 3
	})

	bangAnimInstance = Instance.new("Animation")
	bangAnimInstance.AnimationId = not r15(player) and "rbxassetid://148840371" or "rbxassetid://5918726674"

	bangAnim = humanoid:LoadAnimation(bangAnimInstance)
	bangAnim:Play(0.1, 1, 1)
	bangAnim:AdjustSpeed(3)

	bangDied = humanoid.Died:Connect(function()
		stopBang()
		Fluent:Notify({
			Title = "TrollGe",
			Content = "You died. Bang stopped.",
			SubContent = "Error.",
			Duration = 3
		})
	end)

	local targetHumanoid = targetPlayer.Character:FindFirstChildWhichIsA("Humanoid")
	if targetHumanoid then
		targetDied = targetHumanoid.Died:Connect(function()
			stopBang()
			Fluent:Notify({
				Title = "TrollGe",
				Content = "Bang target died. Stopping...",
				SubContent = "Ended.",
				Duration = 3
			})
		end)
	end

	local bangOffset = CFrame.new(0, 0, 1.1)

	bangLoop = RunService.Stepped:Connect(function()
		pcall(function()
			local targetChar = targetPlayer.Character
			local myChar = player.Character

			if not targetChar or not myChar then
				stopBang()
				Fluent:Notify({
					Title = "TrollGe",
					Content = "Bang target quit. Stopping...",
					SubContent = "Ended.",
					Duration = 3
				})
				return
			end

			local otherRoot = getTorso(targetChar)
			local myRoot = myChar:FindFirstChild("HumanoidRootPart")

			if otherRoot and myRoot then
				myRoot.CFrame = otherRoot.CFrame * bangOffset
			end
		end)
	end)
end

